MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1711551274}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13290f44eeeb1ba408b686c7eb3c777d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableNote
  prompt: Interactioneaza
  title: Bilet mototolit
  text: 'Trei guri deschise in acelasi perete.

    Toate trei mint la fel de frumos.


    Aparentele insala: drumul nu e inainte.

    Intoarce-te acolo unde ai deschis ochii,

    mai sus decat ai privit vreodata.


    Cerul acestei camere are o gura,

    iar zavorul ei cere un dinte de alama.


    Dintele doarme in burta unui fier ruginit,

    la dreapta ta cand stai cu fata la usi.'
  addToInventory: 1
  hideAfterRead: 0
